{
  "name": "spawn-game-studio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.kit.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "npm test --workspaces --if-present",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:spawn": "node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke.mjs",
    "launch:spawn": "node scripts/launch.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "kit/core",
    "kit/engines/godot",
    "kit/engines/node",
    "service"
  ]
}
